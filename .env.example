# Meta Model API key - set in environment, never commit a real key.
META_API_KEY=

# ElevenLabs API key for the audition lane (POST /api/audition). Env only;
# when unset the audition run fails closed with zero calls. Never commit a real key.
# ELEVENLABS_API_KEY=

# Live-capture output for audition runs only: when set to a dataset folder
# (e.g. samples/voa10) the server writes winning WAVs to
# <folder>/media/audition/ and the manifest to <folder>/audition-manifest.json.
# AUDITION_OUTPUT_DIR=

# Optional overrides
META_MODEL=muse-spark-1.1
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Scene-context lane model (segmentation via /v1/responses; default sam-3.1)
# META_SCENE_MODEL=sam-3.1

# Vision enrichment model for the scene-context lane (Stage B1 via /v1/chat/completions; default muse-spark-1.1)
# META_VISION_MODEL=muse-spark-1.1

# Translation verbosity / reasoning control (sent as reasoning_effort to the API).
# Accepted: low (default for translation, ~2x fewer completion tokens), medium, high.
META_REASONING_EFFORT=low

# QA / timing loop overrides (all optional; CLI flags take precedence)
# QA_MAX_ATTEMPTS=3
# QA_TOLERANCE=0.10
# QA_CPS_ES=15
# QA_CPS_EN=15
